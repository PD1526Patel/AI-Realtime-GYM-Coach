# ==============================================================
# Apna AI Gym Coach — Environment Configuration
# ==============================================================

# Required: Groq Cloud API Key for LLM AI Coaching feedback
# Sign up at https://console.groq.com/ to get your free API key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Metered.ca TURN Relay Credentials for Streamlit Cloud deployment
# Required if running in restricted NAT / firewall environments
METERED_DOMAIN=yourdomain.metered.live
METERED_API_KEY=your_metered_api_key

# Alternatively, explicit TURN server details:
# turn_url=turn:global.relay.metered.ca:80
# turn_username=your_username
# turn_password=your_password
